{
  "name": "dsh-persona",
  "version": "1.0.0",
  "description": "Persona and system-prompt manager for DeepSeek Harness: pick an AI persona from the sidebar, guide Chinese chain-of-thought, and apply it to new conversations.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "persona",
    "system-prompt",
    "chain-of-thought"
  ],
  "license": "MIT",
  "author": "Chegan Coco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcalc-lcalc/dsh-persona.git"
  },
  "homepage": "https://github.com/lcalc-lcalc/dsh-persona#readme",
  "bugs": {
    "url": "https://github.com/lcalc-lcalc/dsh-persona/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "files": [
    "index.js",
    "client.js",
    "seed.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/**",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
